rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return userDocExists()
        && myUserDoc().data.active != false;
    }

    function role() {
      return isActiveUser() ? myUserDoc().data.role : null;
    }

    function userParkingLotId() {
      return isActiveUser()
        ? myUserDoc().data.parkingLotId
        : null;
    }

    function belongsToParkingLot(parkingLotId) {
      return isActiveUser()
        && userParkingLotId() == parkingLotId;
    }

    function isViewer() {
      return isActiveUser() && role() == 'viewer';
    }

    function isUser() {
      return isActiveUser() && role() == 'user';
    }

    function isAdmin() {
      return isActiveUser() && role() == 'admin';
    }

    function isPlatformAdmin() {
      return isActiveUser() && role() == 'platform_admin';
    }

    function canUseApp() {
      return isViewer() || isUser() || isAdmin();
    }

    function canOperate() {
      return isUser() || isAdmin();
    }

    match /users/{userId} {
      allow read: if
        isPlatformAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
        )
        || (
          isAdmin()
          && resource.data.parkingLotId == userParkingLotId()
        );

      // Los usuarios solo pueden crearse mediante
      // Cloud Functions con Firebase Admin SDK.
      allow create: if false;

      // El platform_admin puede administrar perfiles.
      allow update: if
        isPlatformAdmin()

        // Un admin normal solo puede modificar usuarios
        // pertenecientes a su misma playa.
        || (
          isAdmin()
          && resource.data.parkingLotId == userParkingLotId()
          && request.resource.data.parkingLotId
            == resource.data.parkingLotId
          && request.resource.data.role in [
            'viewer',
            'user',
            'admin'
          ]
          && request.resource.data
            .diff(resource.data)
            .changedKeys()
            .hasOnly([
              'role',
              'active',
              'updatedAt',
              'updatedByUid',
              'disabledByUid'
            ])
        )

        // Un usuario solo puede actualizar su nombre.
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data
            .diff(resource.data)
            .changedKeys()
            .hasOnly([
              'username',
              'updatedAt'
            ])
        );

      allow delete: if false;
    }

    match /parkingLots/{parkingLotId} {
      allow read: if isPlatformAdmin()
        || belongsToParkingLot(parkingLotId);

      allow create, update, delete: if isPlatformAdmin();
    }

    match /parkingLots/{parkingLotId}/blacklist/{plateId} {
      allow read: if belongsToParkingLot(parkingLotId);

      allow create, update, delete: if isAdmin()
        && belongsToParkingLot(parkingLotId);
    }
    
    match /parkingLots/{parkingLotId}/settings/{docId} {
      allow read: if belongsToParkingLot(parkingLotId);

      allow create, update, delete: if isAdmin()
        && belongsToParkingLot(parkingLotId);
    }

    match /parkingLots/{parkingLotId}/spots/{spotId} {
      allow read: if belongsToParkingLot(parkingLotId);

      allow create, delete: if isAdmin()
        && belongsToParkingLot(parkingLotId);

      allow update: if canOperate()
        && belongsToParkingLot(parkingLotId);
    }

    match /parkingLots/{parkingLotId}/logs/{logId} {
      allow read: if canOperate()
        && belongsToParkingLot(parkingLotId);

      allow create: if canOperate()
        && belongsToParkingLot(parkingLotId);

      allow update: if (
        isAdmin()
        && belongsToParkingLot(parkingLotId)
      ) || (
        isUser()
        && belongsToParkingLot(parkingLotId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'payMethod',
          'updatedAt',
          'editedMethodBy',
          'editedMethodByUid',
          'editedMethodAt'
        ])
      );

      allow delete: if isAdmin()
        && belongsToParkingLot(parkingLotId);
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
