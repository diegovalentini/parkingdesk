rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return userDocExists()
        && myUserDoc().data.active != false;
    }

    function role() {
      return isActiveUser() ? myUserDoc().data.role : null;
    }

    function userParkingLotId() {
      return isActiveUser()
        ? myUserDoc().data.parkingLotId
        : null;
    }

    function belongsToParkingLot(parkingLotId) {
      return isActiveUser()
        && userParkingLotId() == parkingLotId;
    }

    function isViewer() {
      return isActiveUser() && role() == 'viewer';
    }

    function isUser() {
      return isActiveUser() && role() == 'user';
    }

    function isAdmin() {
      return isActiveUser() && role() == 'admin';
    }

    function isPlatformAdmin() {
      return isActiveUser() && role() == 'platform_admin';
    }

    function canUseApp() {
      return isViewer() || isUser() || isAdmin();
    }

    function canOperate() {
      return isUser() || isAdmin();
    }

    function canReadParkingLot(parkingLotId) {
      return isPlatformAdmin()
        || belongsToParkingLot(parkingLotId);
    }

    function canOperateParkingLot(parkingLotId) {
      return isPlatformAdmin()
        || (
          canOperate()
          && belongsToParkingLot(parkingLotId)
        );
    }

    function canAdminParkingLot(parkingLotId) {
      return isPlatformAdmin()
        || (
          isAdmin()
          && belongsToParkingLot(parkingLotId)
        );
    }

    match /users/{userId} {
      allow read: if
        isPlatformAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
        )
        || (
          isAdmin()
          && resource.data.parkingLotId == userParkingLotId()
        );

      // Los usuarios solo pueden crearse mediante
      // Cloud Functions con Firebase Admin SDK.
      allow create: if false;

      // El platform_admin puede administrar perfiles.
      allow update: if
        (
          isPlatformAdmin()
          && !request.resource.data
            .diff(resource.data)
            .changedKeys()
            .hasAny([
              'uid',
              'username',
              'usernameNormalized',
              'email'
            ])
        )

        // Un admin normal solo puede modificar usuarios
        // pertenecientes a su misma playa.
        || (
          isAdmin()
          && resource.data.parkingLotId == userParkingLotId()
          && request.resource.data.parkingLotId
            == resource.data.parkingLotId
          && request.resource.data.role in [
            'viewer',
            'user',
            'admin'
          ]
          && request.resource.data
            .diff(resource.data)
            .changedKeys()
            .hasOnly([
              'role',
              'active',
              'updatedAt',
              'updatedByUid',
              'disabledByUid'
            ])
        );

      allow delete: if false;
    }

    // Registro privado utilizado solamente por Cloud Functions
    // para resolver el acceso mediante un username global.
    match /usernames/{usernameId} {
      allow read, write: if false;
    }

    match /parkingLots/{parkingLotId} {
      allow read: if isPlatformAdmin()
        || belongsToParkingLot(parkingLotId);

      allow create, update, delete: if isPlatformAdmin();
    }

    match /parkingLots/{parkingLotId}/blacklist/{plateId} {
      allow read: if canReadParkingLot(parkingLotId);

      allow create, update, delete: if
        canAdminParkingLot(parkingLotId);
    }

    match /parkingLots/{parkingLotId}/settings/{docId} {
      allow read: if canReadParkingLot(parkingLotId);

      allow create, update, delete: if
        canAdminParkingLot(parkingLotId);
    }

    match /parkingLots/{parkingLotId}/spots/{spotId} {
      allow read: if canReadParkingLot(parkingLotId);

      allow create, delete: if
        canAdminParkingLot(parkingLotId);

      allow update: if
        canOperateParkingLot(parkingLotId);
    }

    match /parkingLots/{parkingLotId}/logs/{logId} {
      allow read: if
        canOperateParkingLot(parkingLotId);

      allow create: if
        canOperateParkingLot(parkingLotId);

allow update: if (
  canAdminParkingLot(parkingLotId)
) || (
  isUser()
  && belongsToParkingLot(parkingLotId)

  // Debe cambiar obligatoriamente el método de pago.
  && request.resource.data.payMethod
    != resource.data.payMethod

  // Solo puede modificar el método y sus datos de auditoría.
  && request.resource.data
    .diff(resource.data)
    .changedKeys()
    .hasOnly([
      'payMethod',
      'updatedAt',
      'editedBy',
      'editedByUid'
    ])

  // Solo se aceptan los dos métodos válidos.
  && request.resource.data.payMethod
    in ['EFECTIVO', 'MP']

  // El UID del editor debe ser el de la sesión.
  && request.resource.data.editedByUid
    == request.auth.uid

  // updatedAt debe ser un serverTimestamp real.
  && request.resource.data.updatedAt
    == request.time
);

      allow delete: if
        canAdminParkingLot(parkingLotId);
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
